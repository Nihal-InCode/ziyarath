# Ziyarah frontend configuration (NON-SECRET values only).
# Copy this file to `.env.local` (local dev) or set these in Vercel -> Settings -> Environment Variables.
# Never put passwords, private keys, service accounts or Google spreadsheet IDs here.

# URL of the deployed Google Apps Script Web App (API endpoint).
# Apps Script editor -> Deploy -> New deployment -> Web app
#   Execute as: Me
#   Who has access: Anyone
# Copy the /exec URL here.
# (Read ONLY on the server by the /api/ziyarah relay - never sent to the browser.)
ZIYARAH_API_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Application display name
NEXT_PUBLIC_APP_NAME=Ziyarah

# Polling interval (ms) used by dashboards for near-real-time refresh.
NEXT_PUBLIC_POLL_INTERVAL_MS=60000
